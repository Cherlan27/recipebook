{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-workflow": {
      "source": {
        "source": "github",
        "repo": "Cherlan27/agent-workflow"
      }
    }
  },
  "enabledPlugins": {
    "agent-workflow@agent-workflow": true
  }
}
